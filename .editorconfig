root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
# intellij_idea rather than ktlint_official: same import/spacing/blank-line
# discipline, without the official style's aggressive signature wrapping and
# 8-space class bodies.
ktlint_code_style = intellij_idea
ktlint_standard_function-naming = disabled
ktlint_standard_property-naming = disabled
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{yml,yaml,toml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
