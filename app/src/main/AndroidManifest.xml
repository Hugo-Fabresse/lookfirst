<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Runtime permission, asked at the first display of the camera view (never at launch). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Normal permission (granted at install, no prompt): lets Window.setHideOverlayWindows(true) work on
         API 31+ (threat model T-UI-3, tapjacking). Not a data permission. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- The camera is optional: the image scan works without one. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <!-- Network: the reputation lists (fixed https addresses of their publishers, ListSources) and the optional redirect check the
         user starts by a tap. Cleartext is forbidden by network_security_config.xml. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Normal permission: WorkManager's network constraint, and knowing whether the device is offline so that the
         optional checks can be disabled. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- WorkManager adds these through the manifest merger; none is needed (no foreground or expedited work, jobs are
         not persisted and the schedule is re-applied at every start), so they are removed. WAKE_LOCK stays:
         WorkManager needs it. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="remove" />

    <!-- Package visibility (API 30+), resolution only: which browsers exist, whether an app other than a browser
         would capture an https link (App Links; best effort, hostless filters only), and the system add-network dialog. No QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_BROWSER" />
        </intent>
        <intent>
            <action android:name="android.settings.WIFI_ADD_NETWORKS" />
        </intent>
    </queries>

    <application
        android:name=".LookFirstApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LookFirst"
        android:usesCleartextTraffic="false">
        <!-- Only exported component of the app. Libraries add SystemJobService (WorkManager, exported but protected by
             the system permission BIND_JOB_SERVICE) and ProfileInstallReceiver (protected by DUMP). Any new exported
             component must go through security-reviewer. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Diagnostics broadcast of WorkManager: exported (DUMP-protected), not needed. -->
        <receiver
            android:name="androidx.work.impl.diagnostics.DiagnosticsReceiver"
            tools:node="remove" />
    </application>
</manifest>
